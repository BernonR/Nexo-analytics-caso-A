# Copiá este archivo como .env y completalo con los insumos del portal del proveedor.
# El archivo .env nunca se sube al repositorio.
PORT=4180
# URL base de la API, sin rutas adicionales
ANALYTICS_BASE_URL=REEMPLAZAR_CON_URL_BASE_DEL_PROVEEDOR
# dev o prod
ANALYTICS_ENV=dev
# Bearer del mismo ambiente. Solo lo usa el backend.
ANALYTICS_BEARER=REEMPLAZAR_CON_BEARER_DEL_AMBIENTE
# Canal web del ambiente elegido (número entero)
ANALYTICS_CHANNEL=REEMPLAZAR_CON_CANAL_WEB
# Tiempo máximo de espera por evento, en milisegundos
ANALYTICS_TIMEOUT_MS=3000
